# Project Leroy - Environment Configuration
# Copy this file to leroy.env and customize as needed

# Detection Model (HAILO8L)
LEROY_DETECTION_MODEL=all_models/yolov11s.hef
LEROY_DETECTION_LABELS=all_models/yolo11s.txt

# Classification Model (ONNX, CPU)
# NOTE: HEF models compiled for Hailo-8 (26 TOPS) are NOT compatible
# with the Hailo-8L (13 TOPS) used in the Pi AI Kit. Use ONNX.
LEROY_CLASSIFICATION_MODEL=all_models/species_classifier_nabirds.onnx
LEROY_CLASSIFICATION_LABELS=all_models/nabirds_labels.txt

# Alternative: Ornimetrics iNaturalist 302-species ONNX
# LEROY_CLASSIFICATION_MODEL=all_models/species_classifier_inat.onnx
# LEROY_CLASSIFICATION_LABELS=all_models/inat_bird_labels.txt

# Future: iNaturalist 964-species (requires compiling HEF via DFC on x86 host)
# See model_build/README.md. Once inat_bird.hef exists:
# LEROY_CLASSIFICATION_MODEL=all_models/inat_bird.hef
# LEROY_CLASSIFICATION_LABELS=all_models/inat_bird_labels.txt

# Web Server Configuration
LEROY_WEB_PORT=80
LEROY_WEB_HOST=localhost

# Browser Auto-Launch
LEROY_AUTO_LAUNCH_BROWSER=true

# Optional: Custom browser command
# LEROY_BROWSER_CMD=chromium-browser

# Camera Resolution Configuration
# Detection resolution: Fast capture for inference (will be resized to 500px anyway)
LEROY_DETECTION_WIDTH=1280
LEROY_DETECTION_HEIGHT=960

# Detection threshold: minimum score for a detection to count as a bird
# Real birds at the feeder score ~0.9+; filters out weaker detections.
LEROY_DETECTION_THRESHOLD=0.9

# Non-bird capture threshold: minimum score for a cat/dog detection to be
# saved to storage/active_learning/non_birds/ for future model training.
# Lower than LEROY_DETECTION_THRESHOLD so false positives are collected.
LEROY_NON_BIRD_THRESHOLD=0.5

# Photo resolution: High quality for saving when birds detected
LEROY_PHOTO_WIDTH=4056
LEROY_PHOTO_HEIGHT=3040
